BEGIN
CREATE TABLE BACKUP_CREDITCHECKMITSDETAIL_DATAFIXHISTORY (
     [CASEID] NVARCHAR(20), [SACTION] VARCHAR(1000), [DTBACKUP] DATETIME ,[HMY] NUMERIC(18, 0) NOT NULL,[HCODE] NUMERIC(18, 0) NULL,[SCODE] CHAR(8) NULL,[HMITS] NUMERIC(18, 0) NOT NULL,[HMYPERSON] NUMERIC(18, 0) NULL,[HPROPERTY] NUMERIC(18, 0) NULL,[SFIRSTNAME] VARCHAR(50) NULL,[SLASTNAME] VARCHAR(50) NULL,[SSPOUSE] VARCHAR(50) NULL,[SGUARANTOR] NVARCHAR(256) NULL,[SMAIDENNAME] VARCHAR(50) NULL,[SMIDDLENAME] VARCHAR(50) NULL,[SNAMESUFFIX] VARCHAR(5) NULL,[DTBIRTHDATE] DATETIME NULL,[SSOCSECNUMBER] CHAR(11) NULL,[SDRIVERSLICENSEID] NVARCHAR(60) NULL,[SDRIVERSLICENSESTATE] CHAR(2) NULL,[SCITIZENSHIP] VARCHAR(20) NULL,[SMARITALSTATUSTYPE] CHAR(10) NULL,[SAPPLICANTTYPE] VARCHAR(20) NULL,[SAPPLICANTIDENTIFIER] CHAR(8) NULL,[DCURRENTRENT] MONEY NULL,[SCONSENTOBTAINED] CHAR(3) NULL,[SEMPLOYMENTSTATUS] VARCHAR(20) NULL,[SEMPLOYMENTTYPE] NVARCHAR(48) NULL,[SEMPLOYERNAME] VARCHAR(60) NULL,[DEMPLOYMENTGROSSINCOME] MONEY NULL,[DTEMPLOYMENTSTARTDATE] DATETIME NULL,[DTEMPLOYMENTENDDATE] DATETIME NULL,[DOTHERINCOMEAMOUNT] MONEY NULL,[SOTHERINCOMETYPE] VARCHAR(40) NULL,[SOTHERINCOMEPERIOD] VARCHAR(10) NULL,[DASSETS] MONEY NULL,[DTOTALLIABILITIES] MONEY NULL,[DNETWORTH] MONEY NULL,[SADDRESSTYPE1] VARCHAR(10) NULL,[SUNPARSEDADDRESS1] NVARCHAR(256) NULL,[SSTREETNUMBER1] VARCHAR(30) NULL,[SSTREETNAME1] NVARCHAR(256) NULL,[SSTREETTYPE1] VARCHAR(30) NULL,[SAPARTMENTNUMBER1] VARCHAR(50) NULL,[SCITY1] VARCHAR(40) NULL,[SSTATE1] VARCHAR(5) NULL,[SZIPCODE1] VARCHAR(12) NULL,[SCOUNTRY1] VARCHAR(15) NULL,[DTDATEMOVEIN1] DATETIME NULL,[DTDATEMOVEOUT1] DATETIME NULL,[SADDRESSTYPE2] VARCHAR(10) NULL,[SUNPARSEDADDRESS2] NVARCHAR(256) NULL,[SSTREETNUMBER2] VARCHAR(30) NULL,[SSTREETNAME2] NVARCHAR(256) NULL,[SSTREETTYPE2] VARCHAR(30) NULL,[SAPARTMENTNUMBER2] VARCHAR(10) NULL,[SCITY2] VARCHAR(40) NULL,[SSTATE2] CHAR(2) NULL,[SZIPCODE2] VARCHAR(12) NULL,[SCOUNTRY2] VARCHAR(15) NULL,[DTDATEMOVEIN2] DATETIME NULL,[DTDATEMOVEOUT2] DATETIME NULL,[SADDRESSTYPE3] VARCHAR(10) NULL,[SUNPARSEDADDRESS3] NVARCHA