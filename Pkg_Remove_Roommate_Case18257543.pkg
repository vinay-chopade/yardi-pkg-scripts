	[CASEID] NVARCHAR(20), [SACTION] VARCHAR(1000), [DTBACKUP] DATETIME , [HMYPERSON] NUMERIC(18, 0) NOT NULL,[HMYTENANT] NUMERIC(18, 0) NULL,[DTMOVEIN] DATETIME NULL,[DTMOVEOUT] DATETIME NULL,[SFIELD11] VARCHAR(30) NULL,[SFIELD12] VARCHAR(30) NULL,[SFIELD13] VARCHAR(30) NULL,[SFIELD14] VARCHAR(30) NULL,[SFIELD15] VARCHAR(30) NULL,[SFIELD16] VARCHAR(30) NULL,[SFIELD17] VARCHAR(30) NULL,[SFIELD18] VARCHAR(30) NULL,[SFIELD19] VARCHAR(30) NULL,[SFIELD20] VARCHAR(30) NULL,[SFIELD21] VARCHAR(30) NULL,[SFIELD22] VARCHAR(30) NULL,[SFIELD23] VARCHAR(30) NULL,[SFIELD24] VARCHAR(30) NULL,[SFIELD25] VARCHAR(30) NULL,[SFIELD26] VARCHAR(30) NULL,[SFIELD27] VARCHAR(30) NULL,[SFIELD28] VARCHAR(30) NULL,[SFIELD29] VARCHAR(30) NULL,[SFIELD30] VARCHAR(30) NULL,[SFIELD31] VARCHAR(30) NULL,[SFIELD32] VARCHAR(30) NULL,[SFIELD33] VARCHAR(30) NULL,[SFIELD34] VARCHAR(30) NULL,[SFIELD35] VARCHAR(30) NULL,[SFIELD36] VARCHAR(30) NULL,[SFIELD37] VARCHAR(30) NULL,[SFIELD38] VARCHAR(30) NULL,[SFIELD39] VARCHAR(30) NULL,[SFIELD40] VARCHAR(30) NULL,[BOCCUPANT] NUMERIC(18, 0) NULL,[BACHOPTOUT] NUMERIC(18, 0) NULL,[SRELATIONSHIP] VARCHAR(30) NULL,[SNOTES] VARCHAR(500) NULL,[SPHONE1] VARCHAR(40) NULL,[SPHONE2] VARCHAR(40) NULL,[SPHONE3] VARCHAR(40) NULL,[SPHONE4] VARCHAR(40) NULL,[IOCCUPANTTYPE] NUMERIC(18, 0) NULL,[DTCREATED] DATETIME NULL,[HUSERCREATEDBY] NUMERIC(18, 0) NULL,[DTLASTMODIFIED] DATETIME NULL,[HUSERMODIFIEDBY] NUMERIC(18, 0) NULL
)
END
GO
INSERT INTO BACKUP_ROOM_DATAFIXHISTORY (
    CASEID, SACTION, DTBACKUP, HMYPERSON, HMYTENANT, DTMOVEIN, DTMOVEOUT, 
    SFIELD11, SFIELD12, SFIELD13, SFIELD14, SFIELD15, SFIELD16, SFIELD17, SFIELD18, 
    SFIELD19, SFIELD20, SFIELD21, SFIELD22, SFIELD23, SFIELD24, SFIELD25, SFIELD26, 
    SFIELD27, SFIELD28, SFIELD29, SFIELD30, SFIELD31, SFIELD32, SFIELD33, SFIELD34, 
    SFIELD35, SFIELD36, SFIELD37, SFIELD38, SFIELD39, SFIELD40, BOCCUPANT, 
    BACHOPTOUT, SRELATIONSHIP, SNOTES, SPHONE1, SPHONE2, SPHONE3, SPHONE4, 
    IOCCUPANTTYPE, DTCREATED, HUSERCREATEDBY, DTLASTMODIFIED, HUSERMODIFIEDBY
)
SELECT 
    '18257543', 
    'DELETE', 
    GETDATE(),
    r.HMYPERSON, r.HMYTENANT, r.DTMOVEIN, r.DTMOVEOUT, 
    r.SFIELD11, r.SFIELD12, r.SFIELD13, r.SFIELD14, r.SFIELD15, r.SFIELD16, r.SFIELD17, r.SFIELD18, 
    r.SFIELD19, r.SFIELD20, r.SFIELD21, r.SFIELD22, r.SFIELD23, r.SFIELD24, r.SFIELD25, r.SFIELD26, 
    r.SFIELD27, r.SFIELD28, r.SFIELD29, r.SFIELD30, r.SFIELD31, r.SFIELD32, r.SFIELD33, r.SFIELD34, 
    r.SFIELD35, r.SFIELD36, r.SFIELD37, r.SFIELD38, r.SFIELD39, r.SFIELD40, 
    r.BOCCUPANT, r.BACHOPTOUT, r.SRELATIONSHIP, r.SNOTES, 
    r.SPHONE1, r.SPHONE2, r.SPHONE3, r.SPHONE4, 
    r.IOCCUPANTTYPE, r.DTCREATED, r.HUSERCREATEDBY, r.DTLASTMODIFIED, 
    r.HUSERMODIFIEDBY
FROM room r
INNER JOIN tenant t ON t.hmyperson = r.hmytenant
WHERE r.hmyperson IN (232163)

GO

DELETE r
FROM   room r
       INNER JOIN tenant t
               ON t.hmyperson = r.hmytenant
       INNER JOIN BACKUP_ROOM_DATAFIXHISTORY bk
               ON bk.hmyperson = r.hmyperson
WHERE  r.hmyperson in  (232163)

