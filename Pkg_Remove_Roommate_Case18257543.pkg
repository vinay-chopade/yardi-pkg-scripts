DELETE p
FROM   person p
       INNER JOIN BACKUP_PERSON_DATAFIXHISTORY bk
               ON bk.hmy = p.hmy
WHERE  p.ucode in ('r0059065')
       AND p.hmy in (232163)
//END SQL