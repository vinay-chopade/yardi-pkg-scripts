IF NOT EXISTS (SELECT 1	FROM SYSOBJECTS	WHERE NAME = 'BACKUP_CREDITCHECKMITSDETAIL_DATAFIXHISTORY' AND XTYPE = 'U')
BEGIN
CREATE TABLE BACKUP_CREDITCHECKMITSDETAIL_DATAFIXHISTORY (
     [CASEID] NVARCHAR(20), [SACTION] VARCHAR(1000), [DTBACKUP] DATETIME ,[HMY] NUMERIC(18, 0) NOT NULL,[HCODE] NUMERIC(18, 0) NULL,[SCODE] CHAR(8) NULL,[HMITS] NUMERIC(18, 0) NOT NULL,[HMYPERSON] NUMERIC(18, 0) NULL,[HPROPERTY] NUMERIC(18, 0) NULL,[SFIRSTNAME] VARCHAR(50) NULL,[SLASTNAME] VARCHAR(50) NULL,[SSPOUSE] VARCHAR(50) NULL,[SGUARANTOR] NVARCHAR(256) NULL,[SMAIDENNAME] VARCHAR(50) NULL,[SMIDDLENAME] VARCHAR(50) NULL,[SNAMESUFFIX] VARCHAR(5) NULL,[DTBIRTHDATE] DATETIME NULL,[SSOCSECNUMBER] CHAR(11) NULL,[SDRIVERSLICENSEID] NVARCHAR(60) NULL,[SDRIVERSLICENSESTATE] CHAR(2) NULL,[SCITIZENSHIP] VARCHAR(20) NULL,[SMARITALSTATUSTYPE] CHAR(10) NULL,[SAPPLICANTTYPE] VARCHAR(20) NULL,[SAPPLICANTIDENTIFIER] CHAR(8) NULL,[DCURRENTRENT] MONEY NULL,[SCONSENTOBTAINED] CHAR(3) NULL,[SEMPLOYMENTSTATUS] VARCHAR(20) NULL,[SEMPLOYMENTTYPE] NVARCHAR(48) NULL,[SEMPLOYERNAME] VARCHAR(60) NULL,[DEMPLOYMENTGROSSINCOME] MONEY NULL,[DTEMPLOYMENTSTARTDATE] DATETIME NULL,[DTEMPLOYMENTENDDATE] DATETIME NULL,[DOTHERINCOMEAMOUNT] MONEY NULL,[SOTHERINCOMETYPE] VARCHAR(40) NULL,[SOTHERINCOMEPERIOD] VARCHAR(10) NULL,[DASSETS] MONEY NULL,[DTOTALLIABILITIES] MONEY NULL,[DNETWORTH] MONEY NULL,[SADDRESSTYPE1] VARCHAR(10) NULL,[SUNPARSEDADDRESS1] NVARCHAR(256) NULL,[SSTREETNUMBER1] VARCHAR(30) NULL,[SSTREETNAME1] NVARCHAR(256) NULL,[SSTREETTYPE1] VARCHAR(30) NULL,[SAPARTMENTNUMBER1] VARCHAR(50) NULL,[SCITY1] VARCHAR(40) NULL,[SSTATE1] VARCHAR(5) NULL,[SZIPCODE1] VARCHAR(12) NULL,[SCOUNTRY1] VARCHAR(15) NULL,[DTDATEMOVEIN1] DATETIME NULL,[DTDATEMOVEOUT1] DATETIME NULL,[SADDRESSTYPE2] VARCHAR(10) NULL,[SUNPARSEDADDRESS2] NVARCHAR(256) NULL,[SSTREETNUMBER2] VARCHAR(30) NULL,[SSTREETNAME2] NVARCHAR(256) NULL,[SSTREETTYPE2] VARCHAR(30) NULL,[SAPARTMENTNUMBER2] VARCHAR(10) NULL,[SCITY2] VARCHAR(40) NULL,[SSTATE2] CHAR(2) NULL,[SZIPCODE2] VARCHAR(12) NULL,[SCOUNTRY2] VARCHAR(15) NULL,[DTDATEMOVEIN2] DATETIME NULL,[DTDATEMOVEOUT2] DATETIME NULL,[SADDRESSTYPE3] VARCHAR(10) NULL,[SUNPARSEDADDRESS3] NVARCHAR(256) NULL,[SSTREETNUMBER3] VARCHAR(30) NULL,[SSTREETNAME3] NVARCHAR(256) NULL,[SSTREETTYPE3] VARCHAR(30) NULL,[SAPARTMENTNUMBER3] VARCHAR(10) NULL,[SCITY3] VARCHAR(40) NULL,[SSTATE3] VARCHAR(10) NULL,[SZIPCODE3] VARCHAR(12) NULL,[SCOUNTRY3] VARCHAR(15) NULL,[DTDATEMOVEIN3] DATETIME NULL,[DTDATEMOVEOUT3] DATETIME NULL,[SACTIVE] CHAR(3) NULL,[STITLE] VARCHAR(5) NULL,[SEMAIL] VARCHAR(128) NULL,[HPROSPECT] NUMERIC(18, 0) NULL,[HMEMBER] NUMERIC(18, 0) NULL,[BSSNNA] NUMERIC(1, 0) NULL,[SADDRESSVERIFICATION1] VARCHAR(20) NULL,[SADDRESSVERIFICATION2] VARCHAR(20) NULL,[SADDRESSVERIFICATION3] VARCHAR(20) NULL,[SEMPLOYMENTVERIFICATION] VARCHAR(30) NULL,[SROHISTORY1] VARCHAR(30) NULL,[SROHISTORY2] VARCHAR(30) NULL,[SROHISTORY3] VARCHAR(30) NULL,[SREEVALUATETYPES] VARCHAR(50) NULL,[SREEVALUATENOTES] VARCHAR(512) NULL,[DTEMPLOYMENTSTARTDATE2] DATETIME NULL,[DTEMPLOYMENTENDDATE2] DATETIME NULL,[BDELETE] NUMERIC(1, 0) NULL,[HUSERCREATEDBY] NUMERIC(18, 0) NULL,[HUSERMODIFIEDBY] NUMERIC(18, 0) NULL,[DTCREATED] DATETIME NULL,[DTLASTMODIFIED] DATETIME NULL,[BMOVEDOUT] NUMERIC(1, 0) NULL,[SCRIMINALRECORDTYPE] VARCHAR(50) NULL,[SCRIMINALRECORDDESC] VARCHAR(500) NULL,[DTCRIMINALRECORD] DATETIME NULL,[BHASCRIMINALRECORD] NUMERIC(1, 0) NULL,[SORIGIN] VARCHAR(20) NULL,[BUPDATED] NUMERIC(1, 0) NULL,[PHONE1] VARCHAR(20) NULL,[PHONE2] VARCHAR(20) NULL,[PHONE3] VARCHAR(20) NULL
)
END
GO
INSERT INTO BACKUP_CREDITCHECKMITSDETAIL_DATAFIXHISTORY (
    CASEID, SACTION, DTBACKUP, HMY, HCODE, SCODE, HMITS, HMYPERSON, HPROPERTY, SFIRSTNAME, SLASTNAME, SSPOUSE, SGUARANTOR,
    SMAIDENNAME, SMIDDLENAME, SNAMESUFFIX, DTBIRTHDATE, SSOCSECNUMBER, SDRIVERSLICENSEID, SDRIVERSLICENSESTATE, SCITIZENSHIP,
    SMARITALSTATUSTYPE, SAPPLICANTTYPE, SAPPLICANTIDENTIFIER, DCURRENTRENT, SCONSENTOBTAINED, SEMPLOYMENTSTATUS,
    SEMPLOYMENTTYPE, SEMPLOYERNAME, DEMPLOYMENTGROSSINCOME, DTEMPLOYMENTSTARTDATE, DTEMPLOYMENTENDDATE, DOTHERINCOMEAMOUNT,
    SOTHERINCOMETYPE, SOTHERINCOMEPERIOD, DASSETS, DTOTALLIABILITIES, DNETWORTH, SADDRESSTYPE1, SUNPARSEDADDRESS1,
    SSTREETNUMBER1, SSTREETNAME1, SSTREETTYPE1, SAPARTMENTNUMBER1, SCITY1, SSTATE1, SZIPCODE1, SCOUNTRY1, DTDATEMOVEIN1,
    DTDATEMOVEOUT1, SADDRESSTYPE2, SUNPARSEDADDRESS2, SSTREETNUMBER2, SSTREETNAME2, SSTREETTYPE2, SAPARTMENTNUMBER2, SCITY2,
    SSTATE2, SZIPCODE2, SCOUNTRY2, DTDATEMOVEIN2, DTDATEMOVEOUT2, SADDRESSTYPE3, SUNPARSEDADDRESS3, SSTREETNUMBER3,
    SSTREETNAME3, SSTREETTYPE3, SAPARTMENTNUMBER3, SCITY3, SSTATE3, SZIPCODE3, SCOUNTRY3, DTDATEMOVEIN3, DTDATEMOVEOUT3,
    SACTIVE, STITLE, SEMAIL, HPROSPECT, HMEMBER, BSSNNA, SADDRESSVERIFICATION1, SADDRESSVERIFICATION2,
    SADDRESSVERIFICATION3, SEMPLOYMENTVERIFICATION, SROHISTORY1, SROHISTORY2, SROHISTORY3, SREEVALUATETYPES,
    SREEVALUATENOTES, DTEMPLOYMENTSTARTDATE2, DTEMPLOYMENTENDDATE2, BDELETE, HUSERCREATEDBY, HUSERMODIFIEDBY, DTCREATED,
    DTLASTMODIFIED, BMOVEDOUT, SCRIMINALRECORDTYPE, SCRIMINALRECORDDESC, DTCRIMINALRECORD, BHASCRIMINALRECORD, SORIGIN,
    BUPDATED, PHONE1, PHONE2, PHONE3
)
SELECT 
    '18257543',
    'UPDATE',
    GETDATE(),
    ccmd.HMY, ccmd.HCODE, ccmd.SCODE, ccmd.HMITS, ccmd.HMYPERSON, ccmd.HPROPERTY, ccmd.SFIRSTNAME, ccmd.SLASTNAME,
    ccmd.SSPOUSE, ccmd.SGUARANTOR, ccmd.SMAIDENNAME, ccmd.SMIDDLENAME, ccmd.SNAMESUFFIX, ccmd.DTBIRTHDATE,
    ccmd.SSOCSECNUMBER, ccmd.SDRIVERSLICENSEID, ccmd.SDRIVERSLICENSESTATE, ccmd.SCITIZENSHIP, ccmd.SMARITALSTATUSTYPE,
    ccmd.SAPPLICANTTYPE, ccmd.SAPPLICANTIDENTIFIER, ccmd.DCURRENTRENT, ccmd.SCONSENTOBTAINED, ccmd.SEMPLOYMENTSTATUS,
    ccmd.SEMPLOYMENTTYPE, ccmd.SEMPLOYERNAME, ccmd.DEMPLOYMENTGROSSINCOME, ccmd.DTEMPLOYMENTSTARTDATE,
    ccmd.DTEMPLOYMENTENDDATE, ccmd.DOTHERINCOMEAMOUNT, ccmd.SOTHERINCOMETYPE, ccmd.SOTHERINCOMEPERIOD, ccmd.DASSETS,
    ccmd.DTOTALLIABILITIES, ccmd.DNETWORTH, ccmd.SADDRESSTYPE1, ccmd.SUNPARSEDADDRESS1, ccmd.SSTREETNUMBER1,
    ccmd.SSTREETNAME1, ccmd.SSTREETTYPE1, ccmd.SAPARTMENTNUMBER1, ccmd.SCITY1, ccmd.SSTATE1, ccmd.SZIPCODE1,
    ccmd.SCOUNTRY1, ccmd.DTDATEMOVEIN1, ccmd.DTDATEMOVEOUT1, ccmd.SADDRESSTYPE2, ccmd.SUNPARSEDADDRESS2,
    ccmd.SSTREETNUMBER2, ccmd.SSTREETNAME2, ccmd.SSTREETTYPE2, ccmd.SAPARTMENTNUMBER2, ccmd.SCITY2, ccmd.SSTATE2,
    ccmd.SZIPCODE2, ccmd.SCOUNTRY2, ccmd.DTDATEMOVEIN2, ccmd.DTDATEMOVEOUT2, ccmd.SADDRESSTYPE3, ccmd.SUNPARSEDADDRESS3,
    ccmd.SSTREETNUMBER3, ccmd.SSTREETNAME3, ccmd.SSTREETTYPE3, ccmd.SAPARTMENTNUMBER3, ccmd.SCITY3, ccmd.SSTATE3,
    ccmd.SZIPCODE3, ccmd.SCOUNTRY3, ccmd.DTDATEMOVEIN3, ccmd.DTDATEMOVEOUT3, ccmd.SACTIVE, ccmd.STITLE, ccmd.SEMAIL,
    ccmd.HPROSPECT, ccmd.HMEMBER, ccmd.BSSNNA, ccmd.SADDRESSVERIFICATION1, ccmd.SADDRESSVERIFICATION2,
    ccmd.SADDRESSVERIFICATION3, ccmd.SEMPLOYMENTVERIFICATION, ccmd.SROHISTORY1, ccmd.SROHISTORY2, ccmd.SROHISTORY3,
    ccmd.SREEVALUATETYPES, ccmd.SREEVALUATENOTES, ccmd.DTEMPLOYMENTSTARTDATE2, ccmd.DTEMPLOYMENTENDDATE2, ccmd.BDELETE,
    ccmd.HUSERCREATEDBY, ccmd.HUSERMODIFIEDBY, ccmd.DTCREATED, ccmd.DTLASTMODIFIED, ccmd.BMOVEDOUT,
    ccmd.SCRIMINALRECORDTYPE, ccmd.SCRIMINALRECORDDESC, ccmd.DTCRIMINALRECORD, ccmd.BHASCRIMINALRECORD, ccmd.SORIGIN,
    ccmd.BUPDATED, ccmd.PHONE1, ccmd.PHONE2, ccmd.PHONE3
FROM creditcheckmitsdetail ccmd
INNER JOIN person p ON p.hmy = ccmd.hmyperson
WHERE p.ucode IN ('r0059065')
  AND ccmd.scode IN ('r0059065')

GO

UPDATE ccmd
SET    ccmd.bdelete = 1
FROM   creditcheckmitsdetail ccmd
       INNER JOIN person p
               ON p.hmy = ccmd.hmyperson
       INNER JOIN BACKUP_CREDITCHECKMITSDETAIL_DATAFIXHISTORY bk
               ON bk.hmyperson = ccmd.hmyperson
WHERE p.ucode IN ('r0059065')
  AND ccmd.scode IN ('r0059065')

IF NOT EXISTS (SELECT 1	FROM SYSOBJECTS	WHERE NAME = 'BACKUP_ROOM_DATAFIXHISTORY' AND XTYPE = 'U')
BEGIN
